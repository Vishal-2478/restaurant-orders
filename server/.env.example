NODE_ENV=development
PORT=4000

# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=
# Neon direct connection string, used only by prisma migrate
DIRECT_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Goal 10: minutes before an open order is flagged as slow,
# and minutes an acknowledgement suppresses the alert before it returns
SLOW_ORDER_MINUTES=15
ALERT_SNOOZE_MINUTES=10

# Timezone used for "today" in the dashboard and CSV export
RESTAURANT_TIMEZONE=Asia/Kolkata